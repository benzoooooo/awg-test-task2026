# Public hostname pointing (A record) to this server, e.g. a No-IP name.
GITPULSE_DOMAIN=gitpulse.ddns.net
# Contact for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com
# Large repository pinned for the demo (comma-separated, never evicted).
GITPULSE_PRELOAD_URLS=https://github.com/django/django
GITPULSE_MAX_REPOS=20
GITPULSE_MAX_REPO_SIZE_MB=1536
# Optional host allowlist, e.g. github.com,gitlab.com
GITPULSE_ALLOWED_HOSTS=
